#!/usr/bin/env python3
"""Fetch one Arkham Horror LCG card from the ArkhamDB public API.

Usage:
    scripts/arkham-card 141
    scripts/arkham-card 01141
"""

from __future__ import annotations

import json
import sys
import urllib.error
import urllib.request

API = "https://arkhamdb.com/api/public"
UA = "board-game-companion (https://github.com/tylerborjeson/board-game-companion)"


def fetch(url: str) -> object:
    request = urllib.request.Request(
        url,
        headers={"Accept": "application/json", "User-Agent": UA},
    )
    with urllib.request.urlopen(request) as response:
        return json.load(response)


def fetch_card(code: str) -> dict | None:
    try:
        payload = fetch(f"{API}/card/{code}")
    except urllib.error.HTTPError:
        return None
    if not isinstance(payload, dict) or not payload.get("code"):
        return None
    return payload


def find_in_pack(pack: str, position: int) -> dict | None:
    try:
        cards = fetch(f"{API}/cards/{pack}")
    except urllib.error.HTTPError:
        return None
    if not isinstance(cards, list):
        return None
    matches = [card for card in cards if card.get("position") == position]
    return matches[0] if matches else None


def lookup(raw: str) -> dict:
    token = raw.strip().lstrip("#")
    if not token.isdigit():
        raise SystemExit(f"expected a collector number, got {raw!r}")

    if len(token) >= 5:
        card = fetch_card(token)
        if card:
            return card
        raise SystemExit(f"no card for code {token}")

    position = int(token)
    card = fetch_card(f"01{position:03d}")
    if card:
        return card
    for pack in ("rcore", "core"):
        card = find_in_pack(pack, position)
        if card:
            return card
    raise SystemExit(f"no card for collector number {position}")


def main() -> None:
    if len(sys.argv) != 2:
        raise SystemExit("usage: scripts/arkham-card <collector-number>")
    json.dump(lookup(sys.argv[1]), sys.stdout, indent=2, sort_keys=True)
    sys.stdout.write("\n")


if __name__ == "__main__":
    main()
